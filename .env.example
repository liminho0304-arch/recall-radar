# Nemotron via Nebius Token Factory (OpenAI-compatible).
# For development you can point this at another OpenAI-compatible host,
# e.g. https://integrate.api.nvidia.com/v1 with an NVIDIA API key.
LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1/
LLM_API_KEY=

# Model IDs exactly as listed by your host.
FAST_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
REASONING_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Tavily search (https://app.tavily.com)
TAVILY_API_KEY=
